---
import Base from '../layouts/Base.astro';
import BandcampEmbed from '../components/BandcampEmbed.astro';
import YouTubeGrid from '../components/YouTubeGrid.astro';
import PostList from '../components/PostList.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Base title="Brenzel Music">
  <div class="home-grid">
    <div class="col-main">
      <p class="col-label">Latest Sounds</p>
      <BandcampEmbed />
      <hr class="rule" />
      <p class="col-label">Recent Posts</p>
      <PostList posts={posts} />
    </div>
    <div class="col-side">
      <p class="col-label">Latest Video</p>
      <YouTubeGrid count={1} featured={true} />
    </div>
  </div>
</Base>

<style>
.home-grid {
  display: grid;
  grid-template-columns: 3fr 2fr;
  gap: 2rem;
}

.col-main {
  border-right: 0.5px solid #000;
  padding-right: 2rem;
}

@media (max-width: 680px) {
  .home-grid {
    grid-template-columns: 1fr;
  }

  .col-main {
    border-right: none;
    padding-right: 0;
    border-bottom: 0.5px solid #000;
    padding-bottom: 2rem;
  }
}
</style>
