---
import type { CollectionEntry } from 'astro:content';

interface Props {
  posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;
---

{posts.length > 0 ? (
  <ul class="post-list">
    {posts.map(post => {
      const formatted = new Date(post.data.date).toLocaleDateString('en-US', {
        year: 'numeric',
        month: 'short',
        day: 'numeric',
      });
      return (
        <li class="post-item">
          <span class="post-date">{formatted}</span>
          <a href={`/blog/${post.slug}`}>{post.data.title}</a>
        </li>
      );
    })}
  </ul>
) : (
  <p>No posts yet.</p>
)}

<style>
.post-list {
  list-style: none;
  padding: 0;
}

.post-item {
  display: grid;
  grid-template-columns: 7rem 1fr;
  gap: 0.5rem;
  padding: 0.4rem 0;
  border-bottom: 0.5px solid #000;
  align-items: baseline;
}

.post-date {
  font-size: 0.75rem;
  white-space: nowrap;
}

.post-item a {
  font-size: 0.9rem;
}
</style>
