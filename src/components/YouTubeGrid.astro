---
interface Props {
  count?: number;
  featured?: boolean;
}

const { count = 6, featured = false } = Astro.props;

const CHANNEL_ID = 'YOUR_CHANNEL_ID_HERE';

let videos: { id: string; title: string }[] = [];

try {
  const res = await fetch(
    `https://www.youtube.com/feeds/videos.xml?channel_id=${CHANNEL_ID}`
  );
  if (res.ok) {
    const xml = await res.text();
    const entries = xml.match(/<entry>([\s\S]*?)<\/entry>/g) ?? [];
    videos = entries.slice(0, count).map(entry => ({
      id: entry.match(/yt:videoId>(.*?)<\/yt:videoId/)?.[1] ?? '',
      title: entry.match(/<media:title>(.*?)<\/media:title>/)?.[1] ?? '',
    })).filter(v => v.id);
  }
} catch {
  // build-time fetch failed — will show placeholder until channel ID is set
}
---

{videos.length > 0 ? (
  <div class={`video-grid${featured ? ' video-featured' : ''}`}>
    {videos.map(video => (
      <div class="video-item">
        <div class="video-ratio">
          <iframe
            src={`https://www.youtube.com/embed/${video.id}`}
            title={video.title}
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          ></iframe>
        </div>
        {!featured && <p class="video-title">{video.title}</p>}
      </div>
    ))}
  </div>
) : (
  <p class="placeholder">
    [YouTube videos load here — set CHANNEL_ID in src/components/YouTubeGrid.astro]
  </p>
)}

<style>
.video-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1rem;
}

.video-featured {
  grid-template-columns: 1fr;
}

.video-ratio {
  position: relative;
  padding-bottom: 56.25%;
  height: 0;
  overflow: hidden;
}

.video-ratio iframe {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border: none;
}

.video-title {
  font-size: 0.8rem;
  margin-top: 0.4rem;
  border-top: 0.5px solid #000;
  padding-top: 0.3rem;
}

@media (max-width: 680px) {
  .video-grid {
    grid-template-columns: 1fr;
  }
}
</style>
